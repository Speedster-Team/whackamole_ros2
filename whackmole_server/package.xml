<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>whackmole_server</name>
  <version>0.0.1</version>
  <description>Whackmole ROS 2 WebSocket bridge — receives spawn/hit/miss events from the iPad web app and publishes to ROS topics.</description>
  <maintainer email="michael.jenz77@gmail.com">Mjenz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libboost-dev</depend>
  <depend>nlohmann-json3-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
